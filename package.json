{
  "name": "buggy-racer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "vite build && tsc -p server/tsconfig.json",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc -p client/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "diag": "tsx scripts/diag/knockback.ts && tsx scripts/diag/curvature.ts && tsx scripts/diag/steering.ts && tsx scripts/diag/multilap.ts && tsx scripts/diag/recorder.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "seed": "tsx scripts/seed-runs.ts",
    "phrases": "node scripts/generate-phrases.mjs",
    "fetch-assets": "node scripts/fetch-mediapipe-assets.mjs",
    "track:info": "tsx scripts/track-info.ts"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@mediapipe/tasks-vision": "0.10.22-rc.20250304",
    "@types/qrcode": "^1.5.6",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "three": "^0.186.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.9.2",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
