{
  "name": "buggy-racer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"bun run dev:client\" \"bun run dev:server\"",
    "dev:client": "bunx --bun vite",
    "dev:server": "bun --watch server/src/index.ts",
    "build": "bunx --bun vite build",
    "start": "bun server/src/index.ts",
    "typecheck": "bunx --bun tsc -p client/tsconfig.json --noEmit && bunx --bun tsc -p server/tsconfig.json --noEmit",
    "diag": "bun scripts/diag/knockback.ts && bun scripts/diag/curvature.ts && bun scripts/diag/steering.ts && bun scripts/diag/multilap.ts && bun scripts/diag/recorder.ts",
    "check:secrets": "bun scripts/check-secrets.mjs",
    "seed": "bun scripts/seed-runs.ts",
    "phrases": "bun scripts/generate-phrases.mjs",
    "fetch-assets": "bun scripts/fetch-mediapipe-assets.mjs",
    "track:info": "bun scripts/track-info.ts"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@mediapipe/tasks-vision": "0.10.22-rc.20250304",
    "@types/qrcode": "^1.5.6",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "three": "^0.186.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/express": "^5.0.3",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
